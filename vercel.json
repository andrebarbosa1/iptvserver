      "source": "/player_api.php",
      "destination": "/api"
    },
    {
      "source": "/get.php",
      "destination": "/api"
    },
    {
      "source": "/xmltv.php",
      "destination": "/api"
    },
    {
      "source": "/epg.xml",
      "destination": "/api"
    },
    {
      "source": "/epg.xml.gz",
